    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
